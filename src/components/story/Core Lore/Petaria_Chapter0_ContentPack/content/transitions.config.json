      "spotlight": { "mobile": [471, 158, 686, 271] }
    },
    "OFFICIAL_SHOP": {
      "route": "/shop",
      "castle_hotspot_id": 1,
      "spotlight": { "mobile": [35, 135, 229, 330] }
    },
    "POST_OFFICE": {
      "route": "/mail",
      "castle_hotspot_id": 6,
      "spotlight": { "mobile": [937, 319, 1077, 495] }
    },
    "RESTAURANT": {
      "route": "/restaurant",
      "castle_hotspot_id": 5,
      "spotlight": { "mobile": [731, 328, 917, 481] }
    },
    "ENTERTAINMENT": {
      "route": "/game-center",
      "castle_hotspot_id": 8,
      "spotlight": { "mobile": [12, 688, 274, 920] }
    },
    "CAPITAL_PORT": {
      "marker": "green_box",
      "route": null,
      "castle_hotspot_id": null,
      "spotlight": {
        "desktop": [1714, 786, 1972, 1014],
        "mobile": [799, 698, 946, 850]
      },
      "note": "Bến tàu trên Kinh thành. Chưa có nút bấm riêng. Highlight ô này, rồi Ari mở bản đồ thế giới."
    },
    "BATTLE_HUB": { "route": "/battle", "nav_label": "Đấu trường" },
    "ARENA": { "route": "/battle/arena", "encounter_key": "ARENA_NPC_LEVEL_1" },
    "TRAINING_CAMP": {
      "route": "/battle/training",
      "required_for_chapter": false,
      "note": "Chỉ nhắc miệng trong CH0_ARENA_INTRO."
    },
    "WORLD_MAP": { "route": "/world-map" },
    "FLOWER_FIELDS": {
      "route": "/region/3-1",
      "region_id": "3-1",
      "name_vi": "Cánh Đồng Vạn Hoa"
    }
  }
}
